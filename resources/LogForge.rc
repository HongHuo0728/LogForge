#include <windows.h>
1 RT_MANIFEST "LogForge.manifest"
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "CompanyName", "LogForge Contributors"
   VALUE "FileDescription", "LogForge HLG to Apple Log transcoder"
   VALUE "FileVersion", "0.1.0"
   VALUE "InternalName", "LogForge"
   VALUE "OriginalFilename", "LogForge.exe"
   VALUE "ProductName", "LogForge"
   VALUE "ProductVersion", "0.1.0"
   VALUE "LegalCopyright", "Copyright (c) 2026 LogForge Contributors"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
