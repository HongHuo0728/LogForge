#include <windows.h>
#include "VersionResource.h"
1 RT_MANIFEST LF_MANIFEST_PATH
101 ICON LF_ICON_PATH
1 VERSIONINFO
FILEVERSION LF_FILE_VERSION
PRODUCTVERSION LF_FILE_VERSION
FILEFLAGSMASK 0x3fL
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "CompanyName", "LogForge Contributors"
   VALUE "FileDescription", "LogForge HLG to Apple Log transcoder"
   VALUE "FileVersion", LF_VERSION_STRING
   VALUE "InternalName", "LogForge"
#ifdef LOGFORGE_CLI
   VALUE "OriginalFilename", "LogForge-cli.exe"
#else
   VALUE "OriginalFilename", "LogForge.exe"
#endif
   VALUE "ProductName", "LogForge"
   VALUE "ProductVersion", LF_VERSION_STRING
   VALUE "LegalCopyright", "Copyright (c) 2026 LogForge Contributors"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
